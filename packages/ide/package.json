{
    "name":  "dsh-ide-ui",
    "description":  "Dual-face ide-ui plugin: host half provides the `ide` Remote namespace (filesystem / git / search primitives); client half renders the VSCode-style Explorer / Search / Source Control / Sessions sidebar and editor column for the DeepSeek Harness Web UI. Unofficial community plugin.",
    "version":  "0.1.0-rc.20",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/baikangwang/dsh-ide-ui.git",
                       "directory":  "packages/ide"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./invariant":  {
                                        "types":  "./lib/types/invariant.d.ts",
                                        "default":  "./lib/invariant.js"
                                    },
                    "./types":  {
                                    "types":  "./lib/types/types.d.ts",
                                    "default":  "./lib/types/types.js"
                                },
                    "./typert":  {
                                     "types":  "./lib/typert.host.d.ts",
                                     "default":  "./lib/typert.host.js"
                                 },
                    "./remote":  {
                                     "types":  "./lib/typert.remote-client.d.ts",
                                     "default":  "./lib/typert.remote-client.js"
                                 },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-api-gateway",
                                              "@deepseek-ai/dsh-client-runtime"
                                          ]
                           }
            },
    "scripts":  {
                    "build":  "tsdown",
                    "typecheck":  "tsc --noEmit"
                },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/invariant.js",
                  "lib/types/**/*.js",
                  "lib/types/**/*.d.ts",
                  "lib/typert.host.js",
                  "lib/typert.host.d.ts",
                  "lib/typert.remote-client.js",
                  "lib/typert.remote-client.d.ts"
              ],
    "license":  "MIT",
    "dependencies":  {
                         "@deepseek-ai/dsh-file-reference":  "0.1.0-rc.8",
                         "zod":  "^4.4.3"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-invariants":  "\u003e=0.1.0-rc.7 \u003c0.2.0-0",
                             "@deepseek-ai/dsh-settings":  "\u003e=0.1.0-rc.7 \u003c0.2.0-0",
                             "@deepseek-ai/dsh-typert-protocol":  "\u003e=0.1.0-rc.7 \u003c0.2.0-0",
                             "@deepseek-ai/schemastery":  "^3.18.1",
                             "react":  "^18.2.0"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@deepseek-ai/dsh-api-gateway":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-api-remotes":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-locale":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-runtime":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-conversation":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-layout":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-primitives":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-settings":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-settings-plugins":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-sidebar":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-client-ui-slots":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-fs":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-invariants":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-sandbox-policy":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-settings":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-subprocess":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-typert-protocol":  "0.1.0-rc.8",
                            "@deepseek-ai/dsh-workspace":  "0.1.0-rc.8",
                            "@deepseek-ai/schemastery":  "^3.18.1",
                            "@types/mdast":  "^4.0.4",
                            "@types/react":  "~18.3.1",
                            "katex":  "^0.16.47",
                            "mdast":  "^3.0.0",
                            "mdast-util-from-markdown":  "^2.0.3",
                            "mdast-util-gfm":  "^3.1.0",
                            "mdast-util-math":  "^3.0.0",
                            "micromark-extension-gfm":  "^3.0.0",
                            "micromark-extension-math":  "^3.1.0",
                            "react":  "^18.2.0",
                            "tsdown":  "^0.22.2",
                            "typescript":  "^5.7.0"
                        }
}