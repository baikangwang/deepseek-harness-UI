{
  "name": "@deepseek-ai/dsh-ide",
  "version": "0.1.0",
  "private": true,
  "description": "VSCode-style unified sidebar for the DeepSeek Harness Web UI: Explorer, Search, Source Control, Sessions.",
  "type": "module",
  "exports": {
    "./host": "./host.js",
    "./client": "./client.js"
  },
  "dsh": {
    "host": {
      "inject": ["fs", "subprocess", "workspaceRegistry", "sandboxPolicy"]
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
