{
  "name": "dsh-ide-ui-bundle",
  "description": "ide-ui 组合包：一键挂载插件（Host dsh-ide-ui + Client dsh-client-ide-ui）到任意 profile。非官方社区插件。",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baikangwang/dsh-ide-ui.git",
    "directory": "packages/bundle"
  },
  "type": "module",
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-ide-ui": "workspace:^",
    "dsh-client-ide-ui": "workspace:^"
  },
  "license": "MIT"
}
